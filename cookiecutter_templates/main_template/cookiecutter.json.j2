{
  "repo_name": {{ env.GITHUB_REPOSITORY.split('/')[-1] | tojson }},
  "repo_owner": {{ env.GITHUB_REPOSITORY.split('/')[0] | tojson }},
  "toolbox_name": {{ config.matlab_toolbox.toolbox_name | tojson }},
  "toolbox_identifier": {{ env.TOOLBOX_UUID | tojson }},
  "namespace_name": {{ config.matlab_toolbox.namespace_name | tojson }},
  "author_name": {{ config.matlab_toolbox.author_name | tojson }},
  "author_email": {{ config.matlab_toolbox.author_email | tojson }},
  "author_company": {{ config.matlab_toolbox.author_company | tojson }},
  "toolbox_summary": {{ config.matlab_toolbox.toolbox_summary | tojson }},
  "toolbox_description": {{ config.matlab_toolbox.toolbox_description | replace('\n', ' ') | replace('\r', ' ') | replace('  ', ' ') | trim | tojson }},
  "license": {{ config.repository.license | tojson }},
  "copyright_holder": {{ config.matlab_toolbox.author_name | tojson }},
  "matlab_version_min": "R2021a",
  "dependencies": {{ config.matlab_toolbox.dependencies | default(['MATLAB']) | join(',') | tojson }},
  "products": {{ config.matlab_toolbox.dependencies | default(['MATLAB']) | join(',') | tojson }},
  "fex_url": {{ config.fileexchange.fex_url | default('', true) | tojson }},
  "codecov_badge_token": {{ config.codecov.badge_token | default('', true) | tojson }},
  "initial_version": "0.1.0",
  "_copy_without_render": [
    "*.yml",
    "*.yaml"
  ]
}
